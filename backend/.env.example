# ==========================================
# Orqen Backend Environment Variables
# ==========================================

# Security
DEBUG=True
SECRET_KEY=replace-this-with-a-secure-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/orqen_db

# Fallback Individual Database Variables (if not using DATABASE_URL)
DB_NAME=orqen_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432

# Logging
DJANGO_LOG_LEVEL=INFO
